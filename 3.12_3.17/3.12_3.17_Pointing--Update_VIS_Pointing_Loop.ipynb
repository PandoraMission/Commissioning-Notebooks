    "## Data Volume"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0f5785c4",
   "metadata": {},
   "source": [
    "Estimate data volume based on obseravtion parameters and estimated rates and sizes. Currently, we're storing data volume constants in CommissFunctions.py, but we my want to store those elsewhere where everyone can reference the most recent numbers."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "77a0bc3a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "test time: 1.6666666666666667 hours\n",
      "52.800000000000004 Gbits\n",
      "22.000000000000004 downlinks\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "' Test reducing temporal resolution for lower data volume. '"
      ]
     },
     "execution_count": 3,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "''' setting observing parameters for the task '''\n",
    "VIS_xpix              = 200 ### saving three 200x200 ROIs\n",
    "VIS_ypix              = 200 \n",
    "regions               = 3  \n",
    "frames_per_int        = 1\n",
    "num_int               = 30000 \n",
    "\n",
    "''' Calculating data volumes '''\n",
    "int_and_reset_time    = frame_time_VIS * frames_per_int\n",
    "bits_per_int          = VIS_xpix * VIS_ypix * regions * bits_per_pix_VIS * stored_frames_per_int_VIS\n",
    "bits_per_sec          = bits_per_int / int_and_reset_time\n",
    "test_time             = num_int * int_and_reset_time  ### seconds\n",
    "bits_per_sec_comp     = bits_per_sec / compression_fractor_VIS\n",
    "bits_test_total       = bits_per_sec_comp * test_time\n",
    "Gbits_test_packet     = bits_test_total / 1E9 * 1.1 * 1.25\n",
    "downlinks             = Gbits_test_packet * 1E9 / (data_rate * 1E6) /60 /pass_time_min \n",
    "\n",
    "print('test time:', test_time/60/60, 'hours')\n",
    "print(Gbits_test_packet, 'Gbits')\n",
    "print(downlinks, 'downlinks')\n",
    "\n",
    "\n",
    "''' Test reducing temporal resolution for lower data volume. '''\n",
    "### This task produces a high data volume. If we need to reduce it, we can reduce the temporal resolution. \n",
    "### The following lines compute how much reduction is needed to achieve the desired data volume.\n",
    "#reduce_by = 1\n",
    "#print('Reduced Temporal Resolution')\n",
    "#print(Gbits_test_packet/reduce_by, 'Gbits')\n",
    "#print(downlinks/reduce_by, 'downlinks')"
   ]
  },
